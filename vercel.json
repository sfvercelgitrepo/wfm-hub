{
  "version": 2,
  "name": "charter-wfm-project-hub",
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "GDWorkshops.html", "use": "@vercel/static" },
    { "src": "WFMEstimates.html", "use": "@vercel/static" },
    { "src": "WFMRequirementsCapabilityMap.html", "use": "@vercel/static" },
    { "src": "WFMSprintProgress.html", "use": "@vercel/static" },
    { "src": "Design.html", "use": "@vercel/static" },
    { "src": "DesignSFDataDictionary.html", "use": "@vercel/static" },
    { "src": "data/design-sf-visibility.json", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/refresh/?$", "dest": "/api/refresh.js" },
    { "src": "/api/design-visibility/?$", "dest": "/api/design-visibility.js" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/GDWorkshops.html", "dest": "/GDWorkshops.html" },
    { "src": "/WFMEstimates.html", "dest": "/WFMEstimates.html" },
    { "src": "/WFMRequirementsCapabilityMap.html", "dest": "/WFMRequirementsCapabilityMap.html" },
    { "src": "/WFMSprintProgress.html", "dest": "/WFMSprintProgress.html" },
    { "src": "/Design.html", "dest": "/Design.html" },
    { "src": "/DesignSFDataDictionary.html", "dest": "/DesignSFDataDictionary.html" },
    { "src": "/data/design-sf-visibility.json", "dest": "/data/design-sf-visibility.json" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
